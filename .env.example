# ── Access ─────────────────────────────────────────────────────────
# Accounts sign in with an email and password, or with Google. Each
# account owns one workspace and sees nothing outside it.
#
# The key session cookies are signed with. Set it to a long random
# string — `openssl rand -hex 32`. Unset, Fynn generates one per
# process and says so, which works but signs everyone out on restart.
FYNN_SECRET=

# Google sign-in. Optional: without these the button is not shown, and
# email and password still work. Create an OAuth 2.0 Client ID (type:
# Web application) at console.cloud.google.com, and register
# <your base URL>/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Anthropic / Claude ─────────────────────────────────────────────
# Powers the exception investigator only (agents/investigator.py).
# Leave blank and exceptions reach the accountant with no suggestion
# attached — a valid state, not a failure.
ANTHROPIC_API_KEY=

# ── Supabase ───────────────────────────────────────────────────────
# Firm profiles, learned rules, retained settlement files, posted entries.
# Leave blank and every write no-ops; the app runs on in-process state.
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=
# Service role key (not anon key) — Settings → API → service_role
SUPABASE_SERVICE_KEY=

# ── Ledger ─────────────────────────────────────────────────────────
# dry-run (default) prepares the entry and posts nothing.
# xero and quickbooks build a real payload against the account mapping,
# but neither makes the HTTP call yet.
LEDGER_ADAPTER=dry-run
# OAuth app credentials. Register the apps first, then set these; the
# accountant connects from Settings and Fynn stores the tokens itself.
# The redirect URI to register is:
#   https://<your-domain>/oauth/xero/callback
#   https://<your-domain>/oauth/quickbooks/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Only for testing against a token obtained by hand. Leave blank in
# production: a stored connection refreshes itself, these do not.
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
QBO_ACCESS_TOKEN=
QBO_REALM_ID=

# ── App URL (Railway sets this automatically) ──────────────────────
RAILWAY_PUBLIC_DOMAIN=web-production-e4ac0.up.railway.app
