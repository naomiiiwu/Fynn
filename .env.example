# ── Anthropic / Claude ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Open Exchange Rates ────────────────────────────────────────────
# Free tier: https://openexchangerates.org
# Leave blank to use hardcoded fallback rates (MYR→SGD = 0.304)
OPENEXCHANGERATES_APP_ID=

# ── Google Sheets ──────────────────────────────────────────────────
# Path to the service account JSON key file
GOOGLE_SHEETS_CREDENTIALS_PATH=fynn-492206-860397b7f950.json
# The Spreadsheet ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Twilio WhatsApp ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number (default) or your approved sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your WhatsApp number (include country code, e.g. +6591234567)
TWILIO_WHATSAPP_TO=

# ── Seller Config ──────────────────────────────────────────────────
SELLER_NAME=My Shop

# ── Schedule Config (24h format, server local time) ────────────────
# Daily ping: hour of day (0-23)
SCHEDULE_DAILY_HOUR=8
# Weekly summary: day of week (mon, tue, wed, thu, fri, sat, sun)
SCHEDULE_WEEKLY_DAY=mon
SCHEDULE_WEEKLY_HOUR=8
# Monthly report: day of month (1-28) and hour
SCHEDULE_MONTHLY_DAY=1
SCHEDULE_MONTHLY_HOUR=8
