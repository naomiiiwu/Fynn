# ── Anthropic / Claude ─────────────────────────────────────────────
# Powers the exception investigator only (agents/investigator.py).
# Leave blank and exceptions reach the accountant with no suggestion
# attached — a valid state, not a failure.
ANTHROPIC_API_KEY=

# ── Supabase ───────────────────────────────────────────────────────
# Firm profiles, learned rules, retained settlement files, posted entries.
# Leave blank and every write no-ops; the app runs on in-process state.
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=
# Service role key (not anon key) — Settings → API → service_role
SUPABASE_SERVICE_KEY=

# ── Twilio WhatsApp ────────────────────────────────────────────────
# Point the sender's webhook at https://<domain>/webhook/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number (default) or your approved sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Ledger ─────────────────────────────────────────────────────────
# dry-run (default) prepares the entry and posts nothing.
# xero prepares a DRAFT manual journal — the HTTP call is not wired up yet.
LEDGER_ADAPTER=dry-run
# Xero OAuth 2.0, accounting.transactions scope. Access tokens expire
# after 30 minutes, so production needs a refresh-token flow.
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=

# ── App URL (Railway sets this automatically) ──────────────────────
# Used to build the digest, setup and upload links Fynn sends over WhatsApp.
RAILWAY_PUBLIC_DOMAIN=web-production-e4ac0.up.railway.app
# Optional override, used when a digest link is issued outside a request
# (scripts, or a host that is not Railway). Falls back to the domain above.
PUBLIC_BASE_URL=
